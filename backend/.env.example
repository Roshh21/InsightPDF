# Copy this file to .env and fill in the values you need.
# Nothing in this file should ever be committed with real secrets.

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Postgres is recommended for anything beyond a local trial. SQLite also
# works out of the box: DATABASE_URL=sqlite:///./insightpdf.db
#
# To create the Postgres role/database referenced by the default below:
#   psql postgres -c "CREATE ROLE insightpdf WITH LOGIN PASSWORD 'insightpdf';"
#   psql postgres -c "CREATE DATABASE insightpdf OWNER insightpdf;"
# (or just run `docker compose up -d postgres`, which creates both for you.)
DATABASE_URL=postgresql+psycopg://insightpdf:insightpdf@localhost:5432/insightpdf

# --- File storage --------------------------------------------------------
MAX_UPLOAD_MB=50

# --- Vector store: "chroma" (local, default) or "qdrant" -----------------
VECTOR_STORE=chroma
# Qdrant: leave QDRANT_URL unset to use an embedded local instance at
# ./data/qdrant (no server needed), or run `docker compose --profile qdrant
# up -d qdrant` and set QDRANT_URL=http://localhost:6333, or point at a
# managed Qdrant Cloud instance with QDRANT_URL + QDRANT_API_KEY. All free.
QDRANT_URL=
QDRANT_API_KEY=

# --- Embeddings: always local and free, never a paid API -----------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =========================================================================
# LLM GATEWAY -- free-hosted-provider-first, automatic failover
# =========================================================================
# Three ordered slots: Primary is tried first, then Secondary, then
# Tertiary. A slot is skipped automatically (not a startup error) if its
# API key below is left blank. The app works with just ONE of these three
# keys set -- more keys just add resilience against a single provider's
# free-tier rate limits. No paid API is required for any of this.
#
# Supported provider ids for *_LLM_PROVIDER: groq | gemini | openrouter |
# anthropic (paid) | openai (paid)
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL_FAST=llama-3.1-8b-instant
PRIMARY_LLM_MODEL_STRONG=llama-3.3-70b-versatile

SECONDARY_LLM_PROVIDER=gemini
SECONDARY_LLM_MODEL_FAST=gemini-3.1-flash-lite
SECONDARY_LLM_MODEL_STRONG=gemini-3.7-flash

TERTIARY_LLM_PROVIDER=openrouter
# OpenRouter's free (":free"-suffixed) model roster rotates frequently.
# If these stop working, pick current ones from https://openrouter.ai/models
# filtered to Free, and update the two lines below.
TERTIARY_LLM_MODEL_FAST=meta-llama/llama-4-scout:free
TERTIARY_LLM_MODEL_STRONG=openai/gpt-oss-120b:free

# Free API keys -- no credit card required for any of these:
#   Groq       -> https://console.groq.com/keys
#   Gemini     -> https://aistudio.google.com/apikey
#   OpenRouter -> https://openrouter.ai/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional, sent as attribution headers on OpenRouter requests (not required).
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=InsightPDF

# Optional PAID providers. Never required -- only used if you set
# PRIMARY/SECONDARY/TERTIARY_LLM_PROVIDER above to "anthropic" or "openai".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

LLM_REQUEST_TIMEOUT_S=60
# Seconds to stop retrying a provider after it returns a rate-limit/quota
# error, so requests don't keep hammering an already-exhausted free tier.
LLM_PROVIDER_COOLDOWN_S=90

# --- Web research tool (optional) -----------------------------------------
TAVILY_API_KEY=

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_REFINE_ATTEMPTS=2
RETRIEVAL_MIN_RELEVANCE=0.35

# --- Evaluation --------------------------------------------------------------
EVALUATION_ENABLED=true
